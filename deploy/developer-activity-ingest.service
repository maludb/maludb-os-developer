# NOTHING HERE HAS BEEN RUN — the owner runs it. Developer's activity log → the tenant's MaluDB (one pass), the kernel's ingest bridge.
# Activity rows carry ids, classes, targets and counts — never SQL text, never a value (design §6.10).
[Unit]
Description=Developer activity log -> the tenant's MaluDB (one pass)
After=network.target postgresql.service

[Service]
Type=oneshot
User=developer-web
Group=developer
WorkingDirectory={{APP_DIR}}
ExecStart={{APP_DIR}}/mcp/venv/bin/python {{APP_DIR}}/mcp/activity_ingest.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
