# NOTHING HERE HAS BEEN RUN — the owner runs it. Developer's directory mirror <- the kernel's change feed (one pass).
[Unit]
Description=Developer directory <- the kernel's change feed (one pass)
After=network.target postgresql.service

[Service]
Type=oneshot
User=developer-web
Group=developer
WorkingDirectory={{APP_DIR}}
ExecStart=/usr/bin/php {{APP_DIR}}/bin/directory_sync.php
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
