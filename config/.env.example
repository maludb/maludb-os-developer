# Developer — config/.env (written by the kernel's installer at apply; the three ports, DX_DOOR_SOCKET and DX_DOOR_KEY pinned first by
# deploy/ROOT_STEPS.sh; design §14). Never commit the real file. Readable by the group `developer` (the PHP-FPM pool's user and the MCP
# servers' user — never the web server's shared uid; ROOT_STEPS.sh re-groups it after every apply until K54); nothing in it is ever
# logged, printed or returned. NOT HERE, EVER: a password of any target database or of the tool's cluster roles — those are in the
# door's and the grants service's own passfiles, readable only by their service (design §6.1).
APP_ENV=prod
APP_DEBUG=0
APP_NAME="Developer"
APP_KEY=developer
APP_URL=https://developer.example.com
# the record database (the installer creates it and the three roles)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=subello_developer
DB_USER=developer_rw
DB_PASSWORD=
MCP_RECORDS_DB_USER=developer_records_ro
MCP_RECORDS_DB_PASSWORD=
MCP_ACTIVITY_DB_USER=developer_activity_ro
MCP_ACTIVITY_DB_PASSWORD=
# the ports (pinned before the first apply: deploy/ROOT_STEPS.sh step 0 — the installer otherwise picks the first free port from 8100)
APP_INTERNAL_PORT=8201
MCP_RECORDS_PORT=8858
MCP_ACTIVITY_PORT=8859
# the door (design §6.1): its Unix socket (group `developer`) and the key PHP and the MCP servers sign every request with
# (32 random bytes, hex; ROOT_STEPS.sh writes it once). The door refuses an unsigned request and a peer outside its group.
DX_DOOR_SOCKET=/run/developer/door.sock
DX_DOOR_KEY=
# the screens' limits the door also enforces from dx_settings (design §6.1, D8)
DX_SHOW_ROWS=1000
DX_SHOW_BYTES=8388608
# Graphviz for the focused ER diagrams (design §6.7; the owner's apt package)
DX_DOT=/usr/bin/dot
# the kernel's (copied by the installer)
ACTION_TOKEN_KEY=
ACTIONS_RELAY_KEY=
OS_APPLICATION_TOKEN=
OS_INTERNAL_URL=http://127.0.0.1:8080
OS_LAUNCHER_URL=https://app.example.com/
# the tenant's one memory (activity episodes: ids, classes and counts, never SQL text or a value) — Developer keeps no memory database
MALUDB_API_URL=http://127.0.0.1:8000
MALUDB_API_TOKEN=
# notification mail (optional; the installer fills them from ~/.malumail or the kernel's) — the bell's mail copies only
MALUMAIL_API_URL=https://api.malumail.com
MALUMAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
# export files until downloaded (default storage/ under the application; the PHP-FPM pool's user writes it)
DX_STORAGE_DIR=storage
# CORS origins for a token API, comma-separated (none: Developer has no token API in v1)
API_CORS_ORIGINS=
