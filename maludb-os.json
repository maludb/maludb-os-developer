{
    "schema": "maludb-os.application/1",
    "catalog_key": "developer",
    "name": "Developer",
    "description": "The business's database development and administration tool — what phpMyAdmin is to MySQL, for PostgreSQL and the MaluDB memory system, for admins, software engineers and DBAs. Every registered database's objects with their DDL, dependencies and statistics; forms that end on one Change review page showing the exact SQL, the lock it takes and whether it rewrites the table, linted and rehearsed on a throwaway copy; workbenches where schemas are designed live and exported as the next numbered migration for an application's repository — installed applications' schemas change only that way; data read at a level granted per person, with personal columns masked by the database's own privileges and row edits made in a time-boxed window and undoable; the SQL editor with plans; what the server is doing, maintenance and health findings; a curated, read-only view of the memory databases. One door holds the tool's database credentials and audits every statement.",
    "business_area": "Technology & Infrastructure",
    "category": "database",
    "icon": "feather-database",
    "version": "0.1.0",
    "criticality": "high",
    "grant_standing_departments": false,
    "runtime": {
        "php_pool": "developer"
    },
    "vhost": {
        "label": "developer",
        "document_root": "html",
        "internal_port_env": "APP_INTERNAL_PORT"
    },
    "database": {
        "suffix": "developer",
        "migrations": "db",
        "roles": {
            "rw": "developer_rw",
            "records_ro": "developer_records_ro",
            "activity_ro": "developer_activity_ro"
        }
    },
    "env": {
        "required": [
            "APP_NAME",
            "APP_URL",
            "DB_HOST",
            "DB_PORT",
            "DB_NAME",
            "DB_USER",
            "DB_PASSWORD",
            "MCP_RECORDS_DB_USER",
            "MCP_RECORDS_DB_PASSWORD",
            "MCP_ACTIVITY_DB_USER",
            "MCP_ACTIVITY_DB_PASSWORD",
            "APP_INTERNAL_PORT",
            "MCP_RECORDS_PORT",
            "MCP_ACTIVITY_PORT",
            "ACTION_TOKEN_KEY",
            "ACTIONS_RELAY_KEY",
            "OS_APPLICATION_TOKEN",
            "OS_INTERNAL_URL",
            "OS_LAUNCHER_URL",
            "APP_KEY",
            "MALUDB_API_URL",
            "MALUDB_API_TOKEN",
            "DX_DOOR_SOCKET",
            "DX_DOOR_KEY"
        ],
        "optional": [
            "MALUMAIL_API_KEY",
            "MAIL_FROM",
            "MAIL_FROM_NAME",
            "DX_DOOR_POOL_MAX",
            "DX_SHOW_ROWS",
            "DX_SHOW_BYTES",
            "DX_DOT"
        ]
    },
    "services": [
        "deploy/developer-records-mcp.service",
        "deploy/developer-activity-mcp.service",
        "deploy/developer-activity-ingest.service",
        "deploy/developer-activity-ingest.timer",
        "deploy/developer-directory-sync.service",
        "deploy/developer-directory-sync.timer",
        "deploy/developer-worker.service",
        "deploy/developer-worker.timer",
        "deploy/developer-door.socket",
        "deploy/developer-door.service",
        "deploy/developer-grants.service"
    ],
    "endpoints": [
        {
            "name": "Web UI",
            "kind": "ui",
            "path": "/",
            "auth_kind": "none",
            "agent_reachable": false
        },
        {
            "name": "Health",
            "kind": "http_api",
            "path": "/api/v1/health",
            "auth_kind": "none",
            "agent_reachable": false
        },
        {
            "name": "Records MCP",
            "kind": "mcp",
            "path": "/mcp/records",
            "auth_kind": "bearer",
            "agent_reachable": true,
            "mcp_surface_version": 1
        },
        {
            "name": "Activity MCP",
            "kind": "mcp",
            "path": "/mcp/activity",
            "auth_kind": "bearer",
            "agent_reachable": true,
            "mcp_surface_version": 1
        }
    ],
    "actions": {
        "manifest": "docs/developer-action-manifest.md",
        "registry": "mcp/action_registry.json",
        "base_url_env": "APP_INTERNAL_PORT"
    },
    "skills": [
        "skills/developer-basics",
        "skills/reading-postgres",
        "skills/safe-ddl",
        "skills/explaining-plans",
        "skills/maludb-memory-rules",
        "skills/investigate-a-slow-query",
        "skills/find-what-is-blocking",
        "skills/draft-an-index",
        "skills/design-a-table-on-a-workbench",
        "skills/weekday-dba-note"
    ],
    "sso": {
        "path": "/sso",
        "logout_path": "/sso/logout"
    },
    "directory": {
        "reads": true,
        "writes": false
    },
    "assistant": {
        "command_bar": true,
        "agent": "expert"
    },
    "agents": [
