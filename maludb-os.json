        {
            "key": "advisor",
            "name": "DBA Advisor",
            "job_description": "os/advisor.md",
            "access_capability": "write",
            "hired_on_install": true,
            "roles": [
                "engineer"
            ],
            "duty": {
                "name": "The weekday DBA note",
                "schedule_cron": "20 7 * * 1-5",
                "runbook": "skills/weekday-dba-note",
                "instructions": "Every weekday, follow the runbook weekday-dba-note: read the health findings, the top statements, drift, the migration drafts not yet observed applied, the workbenches near expiry and the windows used across the registered databases; propose each fix as a change set (change_set_propose) for a DBA to review; then write one short note for the DBA role holders and send the kernel's Sysadmin agent the same summary. Read no rows, apply nothing, ask for no window and no unmask."
            },
